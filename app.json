{
  "expo": {
    "name": "BanKoni",
    "slug": "bankoni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sami7ma.bankoni"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sami7ma.bankoni",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/BankoniDrawerNObaground.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "expo-document-picker",
      "expo-file-system",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/BankoniDrawerNObaground.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "25e5e0d4-d01a-43cb-a84f-ff818490aef6"
      }
    }
  }
}
